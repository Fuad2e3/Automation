      "parameters": {
        "jsCode": "let url = $json.Website; if (!url) return { Website: 'invalid' }; if (!url.startsWith('http')) url = 'https://' + url; const match = url.match(/^(?:https?:\\/\\/)?(?:[^@\\n]+@)?(?:www\\.)?([^:\\/\\n?]+)/); const domain = match ? match[1] : url; return { Website: $json.Website, url, domain, 'Status': 'Searching...', 'Home': 'Searching...', 'About Us': 'Not Found', 'Contact Us': 'Not Found', 'Services': 'Not Found' };"
      },
