    {
      "parameters": {
        "jsCode": "const html = String($json.data || ''); const initData = $('InitWebsite').last().json; const Website = initData.Website; const rootUrl = initData.url; const domain = initData.domain; const links = []; const linkRegex = /<a\\s+(?:[^>]*?\\s+)?href=([\"'])(.*?)\\1/gi; let match; while ((match = linkRegex.exec(html)) !== null) { let url = match[2]; if (url.startsWith('/')) url = rootUrl.replace(/\\/$/, '') + url; else if (!url.startsWith('http')) url = rootUrl.replace(/\\/$/, '') + '/' + url; if (url.includes(domain)) links.push(url); } let cleaned = html.replace(/<(script|style|iframe|noscript|svg|button|form)[^>]*>[\\s\\S]*?<\\/\\1>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim(); const targets = []; targets.push({ type: 'home', Website, column: 'Home', content: cleaned.substring(0, 48000) }); const find = (words) => links.find(l => words.some(w => l.toLowerCase().includes(w))); const about = find(['about', 'story', 'company', 'who-we-are']); if (about) targets.push({ type: 'crawl', Website, column: 'About Us', url: about }); const contact = find(['contact', 'support', 'reach', 'location']); if (contact) targets.push({ type: 'crawl', Website, column: 'Contact Us', url: contact }); const services = find(['service', 'solution', 'product', 'expertise', 'work']); if (services) targets.push({ type: 'crawl', Website, column: 'Services', url: services }); return targets;"
      },
